{
  "manifest_version": 3,
  "name": "Harrison Anki Bridge",
  "version": "0.1.2",
  "description": "Export Notebook study material to Anki.",
  "browser_specific_settings": {
    "gecko": {
      "id": "harrison-anki-bridge@example.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": [
    "https://notebook.google.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Harrison Anki Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://notebook.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}