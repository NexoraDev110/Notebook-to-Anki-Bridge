{
  "manifest_version": 3,
  "name": "Notebook to Anki Bridge",
  "version": "0.3.8",
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "96": "icons/logo-96.png",
    "128": "icons/logo-128.png"
  },
  "description": "Capture flashcards from supported Google Notebook pages and export them to Anki.",
  "minimum_chrome_version": "111",
  "host_permissions": [
    "https://notebook.google.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Notebook to Anki Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "48": "icons/logo-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://notebook.google.com/*"
      ],
      "js": [
        "network-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://notebook.google.com/*"
      ],
      "js": [
        "rpc-parser.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
